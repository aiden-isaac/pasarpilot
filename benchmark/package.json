{
  "name": "@pasarpilot/browser-benchmark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:database": "npm run build && node --test --test-concurrency=1 dist/test/integration/*.test.js",
    "test:fixture": "npm run build && node --test --test-concurrency=1 dist/test/live/*.test.js",
    "benchmark": "node dist/src/cli.js",
    "trading": "node dist/src/trading/cli.js",
    "test:trading:unit": "npm run build && node --test dist/test/trading/unit/*.test.js",
    "test:trading:database": "npm run build && node --test --test-concurrency=1 dist/test/trading/database/*.test.js",
    "test:trading:operations": "npm run build && node --test --test-concurrency=1 dist/test/trading/operations/*.test.js",
    "test:trading:restore": "npm run build && node --test dist/test/trading/restore/*.test.js",
    "test:trading:dashboard": "npm run build && node --test --test-concurrency=1 dist/test/trading/dashboard/*.test.js"
  },
  "dependencies": {
    "pg": "8.23.1",
    "pg-boss": "10.4.2",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.20.0",
    "typescript": "5.9.3"
  }
}
